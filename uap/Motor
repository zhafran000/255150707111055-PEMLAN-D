package rental;

class Motor extends Kendaraan {
    private String jenisTransmisi;

    public Motor(String kode, String nama, double hargaSewaPerHari, String jenisTransmisi) {
        super(kode, nama, hargaSewaPerHari);
        this.jenisTransmisi = jenisTransmisi;
    }

    public String getJenisTransmisi() {
        return jenisTransmisi;
    }

    @Override
    public double hitungBiayaSewa(int lamaSewa) {
        double total = lamaSewa * getHargaSewaPerHari();

        // Tambahan biaya asuransi motor matik
        if (jenisTransmisi.equalsIgnoreCase("matik")) {
            total += (10000 * lamaSewa);
        }

        return total;
    }

    @Override
    public void tampilkanInfo() {
        System.out.println("[MOTOR] Kode: " + getKode()
                + " | Nama: " + getNama()
                + " | Transmisi: " + jenisTransmisi
                + " | Tarif: Rp" + getHargaSewaPerHari() + "/hari"
                + " | Status: " + (isTersedia() ? "Tersedia" : "Tidak Tersedia"));
    }
}
